# Container image and immutable version published by CI.
APP_IMAGE=ghcr.io/typeitorg/boero-ui
APP_VERSION=sha-replace-with-commit-sha

# Host port used by Nginx to reach the application.
APP_HOST_PORT=3000

# Keep false for HTTP and enable it when HTTPS is available.
AUTH_COOKIE_SECURE=false

# Backend API URL reachable from the application container.
BOERO_API_URL=http://host.docker.internal
